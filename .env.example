# App
PROJECT_NAME="Sync Without Signal BE"
ENVIRONMENT="development"          # development | staging | production
PORT=3000
API_V1_PREFIX="/api/v1"
CORS_ORIGINS="http://localhost:5173,https://pos-app.com"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRATION_TIME="1d"

# Database (Prisma + Supabase Postgres)
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD_URL_ENCODED]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD_URL_ENCODED]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Sync Configuration
MAX_OFFLINE_SYNC_DELAY_MINUTES=1440
