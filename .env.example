# App
PROJECT_NAME="K-POS API"
ENVIRONMENT="development"          # development | staging | production
PORT=3001
API_PREFIX="/api/v1"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-this"
OFFLINE_LEASE_SECRET="another-long-random-secret-change-this"
JWT_EXPIRATION_TIME="15m"
OFFLINE_LEASE_TTL="7d"

# Database Connection
# ------------------------------------------------------------------------------
# 1. Supabase / Cloud Postgres (Default)
DATABASE_URL="postgresql://postgres:kpos-secret@localhost:5432/kpos_db?schema=public"
DIRECT_URL="postgresql://postgres:kpos-secret@localhost:5432/kpos_db?schema=public"
DATABASE_SSL="false"
DATABASE_POOL_MAX=32
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=5000

# 2. Local Docker Postgres (Gunakan ini jika menjalankan docker-compose up -d)
# For managed PostgreSQL set DATABASE_SSL=true and provide provider URLs.

# Sync Configuration
MAX_OFFLINE_SYNC_DELAY_MINUTES=1440

# Message Queue
# ------------------------------------------------------------------------------
# 1. CloudAMQP (Cloud)
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_PREFETCH=8
REPORTING_BATCH_SIZE=100
REPORTING_CONCURRENCY=4

# 2. Local Docker RabbitMQ (Gunakan ini jika menjalankan docker-compose up -d)
# RabbitMQ must use persistent storage in hosted environments.
